# dt818-console Cloudflare Worker push config.
# Copy to .env (gitignored) once Worker is deployed.
#
# CONSOLE_API_BASE is the deployed Worker URL (output of `wrangler deploy`).
# CONSOLE_INGEST_TOKEN must match the secret set via `wrangler secret put INGEST_TOKEN`.

CONSOLE_API_BASE=https://dt818-console-api.<your-cf-account>.workers.dev
CONSOLE_INGEST_TOKEN=replace_with_32_byte_hex
