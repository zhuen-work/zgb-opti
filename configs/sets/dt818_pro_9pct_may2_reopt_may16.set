; DT818_pro - 3-stream ORB rank portfolio, 9% total per setup (EXTREME RISK)
; Next WFO: May 16 2026
;
; ** WARNING: EXTREME risk. Expect 30-50% live DD. Only for accounts that can
; ** absorb major drawdowns AND psychologically handle 6-figure equity swings.
;
; Architecture: top 3 ranks from May 2 joint-session WFO running in parallel.
; _RiskPct = 3.0 per stream so total when all 3 fire together = 9.0%.
; Each stream has both LDN and NY enabled. Independent magics + caps.

; ===== Global account =====
_CapitalProtectionAmount=0.0||0.0||1||0.0||0.0||N
_RiskPct=3.0||3.0||1||3.0||3.0||N
_LotMode=1||1||1||1||1||N
TierBase=2000||2000||1||2000||2000||N
LotStep=0.01||0.01||1||0.01||0.01||N
_MaxSpreadPts=50||50||1||50||50||N

; ===== ORB shared params =====
_BrokerGMTOffsetHours=0||0||1||0||0||N
_ORB_BufferPts=0||0||1||0||0||N
_ORB_MinRangePts=200||200||1||200||200||N
_ORB_MaxRangePts=5000||5000||1||5000||5000||N
_ORB_LDN_Enabled=true
_ORB_LDN_StartHour=7||7||1||7||7||N
_ORB_NY_Enabled=true
_ORB_NY_StartHour=13||13||1||13||13||N

; ===== ORB_S1 — rank 1 (magic 1111) =====
_ORB_S1_Enabled=true
