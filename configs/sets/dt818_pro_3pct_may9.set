; DT818_pro - 3-stream ORB rank portfolio, 3.0% total per setup
; Generated 2026-05-09 from wfo_orb_may9
;
; Architecture: top 3 ranks from joint-session WFO running in parallel.
; _RiskPct = 1.0 per stream so total when all 3 fire together = 3.0%.
; Each stream has both LDN and NY enabled. Independent magics + caps.
;
; Top-N ranks selected:
;   Rank 1: Range=90/SL=650/RR=4.0/HTP=0.25  P0=PASS slope=+24.0% plat=$5,126
;   Rank 2: Range=90/SL=350/RR=4.0/HTP=0.5  P0=FAIL slope=-71.3% plat=$6,317
;   Rank 3: Range=90/SL=400/RR=4.0/HTP=0.5  P0=FAIL slope=-75.2% plat=$6,282
;
; Spread guard: _MaxSpreadPts=50 (Vantage max observed 32pt; 50pt = 56% safety margin)

; ===== Global account =====
_CapitalProtectionAmount=0.0||0.0||1||0.0||0.0||N
_RiskPct=1.0||1.0||1||1.0||1.0||N
_LotMode=1||1||1||1||1||N
TierBase=2000||2000||1||2000||2000||N
LotStep=0.01||0.01||1||0.01||0.01||N
_MaxSpreadPts=50||50||1||50||50||N

; ===== ORB shared params =====
