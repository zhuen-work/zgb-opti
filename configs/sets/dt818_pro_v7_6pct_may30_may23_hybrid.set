; DT818_pro_v7 HYBRID - 6-stream ORB rank portfolio + 6 STOP-ext hedges + SMA(8,21) cross-exit
; Generated 2026-05-28 — HYBRID setfile combining two WFO spread assumptions:
;   S1-S3 = top-3 from may23 WFO at SPREAD=30pt (live-match assumption)
;     output/wfo_orb_v2_may23_spread30/oos_rank.csv
;   S4-S6 = top-3 from may23 WFO at SPREAD=60pt (historical conservative default)
;     output/wfo_orb_v2_may23/oos_rank.csv  (no _spread suffix = 60pt default)
;
; Rationale: 3-window forward test (2026-05-27) showed spread30 picks aggregate
; to +54% NP vs spread60 at ~identical DD% across 17 days. But sim != live.
; This hybrid runs BOTH cohorts in production so live trade-level data reveals
; which is genuinely better. After 2-4 weeks of live data, switch fully to the
; winning cohort.
;
; Cohort tracking — each stream's _Comment encodes the cohort:
;   S1-S3: ORB_S{N}_v7sp30_may23  (spread=30 cohort)
;   S4-S6: ORB_S{N}_v7sp60_may23  (spread=60 cohort)
; live_check.py + journal can group P&L by comment-prefix for cohort attribution.
;
; PARENT total risk: 6.0% (1.0% × 6 streams).
; Hedges: unchanged from v7 STOP-ext (ExtPts=100, TPMult=3.0, SLMult=1.0).
;
; Spread guard: _MaxSpreadPts=60

; ===== Global account =====
_CapitalProtectionAmount=0.0||0.0||1||0.0||0.0||N
_RiskPct=1.0||1.0||1||1.0||1.0||N
_LotMode=1||1||1||1||1||N
TierBase=2000||2000||1||2000||2000||N
LotStep=0.01||0.01||1||0.01||0.01||N
_MaxSpreadPts=60||60||1||60||60||N

; ===== ORB shared params (v5/v6 globals incl. V2 fractal-confirm) =====
_BrokerGMTOffsetHours=0||0||1||0||0||N  ; DEPRECATED post 2026-05-07 (EA uses TimeGMT)
_ORB_MinRangePts=0||0||1||0||0||N             ; range filter DISABLED
_ORB_MaxRangePts=999999||999999||1||999999||999999||N
_ORB_LDN_Enabled=true
_ORB_LDN_StartHour=4||4||1||4||4||N
_ORB_NY_Enabled=true
_ORB_NY_StartHour=10||10||1||10||10||N
_ORB_FractalConfirm=true                     ; v5/v6: V2 gate ALL streams
_ORB_FractalWidth=5||5||1||3||5||N           ; Bill Williams 5-bar fractal
_ORB_SMA_CrossExit=true                       ; v7: SMA(8)x(21) cross-exit on post-HTP runner
_ORB_SMA_FastPeriod=8||8||1||8||8||N           ; LOCKED 2026-05-26 (V5 sweep winner)
_ORB_SMA_SlowPeriod=21||21||1||21||21||N       ; LOCKED 2026-05-26 (V5 sweep winner)

